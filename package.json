{
  "name": "@cfigueiroa/foster",
  "version": "0.61.0",
  "description": "Bring Claude Desktop Code sessions from a previous local account back into your current account's sidebar — non-destructively and reversibly.",
  "keywords": [
    "claude",
    "claude-desktop",
    "claude-code",
    "sessions",
    "cli"
  ],
  "homepage": "https://github.com/cfigueiroa/foster#readme",
  "bugs": "https://github.com/cfigueiroa/foster/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfigueiroa/foster.git"
  },
  "license": "MIT",
  "author": "Caio Figueirôa",
  "type": "module",
  "bin": {
    "foster": "dist/foster.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set",
    "privacy": "node scripts/privacy.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run privacy && npm run coverage",
    "equivalence": "tsx scripts/scan-equivalence.ts"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.281",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9.39.1",
    "prettier": "^3.9.9",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1",
    "zod": "^4.6.5"
  }
}
